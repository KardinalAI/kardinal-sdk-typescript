{
  "name": "@kardinal-ai/sdk",
  "version": "1.1.0",
  "description": "Kardinal TypeScript SDK: route optimization plans and solutions.",
  "license": "MIT",
  "author": "Kardinal",
  "homepage": "https://developers.kardinal.ai/sdks/overview",
  "bugs": {
    "url": "https://github.com/KardinalAI/kardinal-sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KardinalAI/kardinal-sdk-typescript.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/routing/examples.d.ts",
      "default": "./dist/routing/examples.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kardinal": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:types": "bash scripts/generate-types.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:spec": "node scripts/check-spec-matches-mintlify.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "commander": "^12.1.0"
  },
  "peerDependenciesMeta": {
    "commander": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "commander": "^12.1.0",
    "js-yaml": "4.3.2",
    "msw": "^2.6.4",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  }
}
